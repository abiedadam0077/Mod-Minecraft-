# First launch creates the initial admin. Never commit real credentials.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-characters
PORT=3001
# Optional comma-separated web origins; include the bundled Android origin.
# ALLOWED_ORIGINS=https://craftly.example.com,https://appassets.androidplatform.net
# DATA_DIR=/data/craftly
